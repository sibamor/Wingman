{
  "name": "wingman",
  "description": "Помощник продавца FunPay: автоподнятие, автоответы, уведомления, аналитика продаж и массовая правка лотов. Открытый код.",
  "private": true,
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/sibamor/Wingman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sibamor/Wingman.git"
  },
  "bugs": {
    "url": "https://github.com/sibamor/Wingman/issues"
  },
  "version": "0.18.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "theme": "node scripts/gen-theme.mjs",
    "theme:audit": "node scripts/audit-theme.mjs",
    "release": "npm version patch -m \"Wingman %s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Wingman %s\" && git push --follow-tags",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.28",
    "typescript": "^5.9.2",
    "wxt": "^0.21.4"
  }
}
